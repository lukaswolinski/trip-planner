# Copy to .env.local and fill in. .env.local is gitignored; this file must stay valueless.
#
# Only DATABASE_URL and the three secrets are required. Routing, geocoding and
# map tiles all default to keyless providers, so the app works with no map
# account at all.

# --- Database ---------------------------------------------------------------
# Any Postgres. On Vercel use Neon's POOLED connection string.
DATABASE_URL=

# --- Secrets (required) -----------------------------------------------------
# Signs the session cookie. Generate: openssl rand -base64 32
SESSION_SECRET=

# Salts the HMAC of client IPs used as rate-limit keys, so raw IPs are never
# stored. Generate: openssl rand -base64 32
RATE_LIMIT_PEPPER=

# Bearer token required by GET /api/cron/cleanup. Without it the cleanup
# endpoint would be a public bulk-delete. Generate: openssl rand -base64 32
CRON_SECRET=

# --- Provider selection -----------------------------------------------------
# osrm (default, keyless) | mapbox
ROUTING_PROVIDER=osrm
# photon (default, keyless) | mapbox
GEOCODING_PROVIDER=photon

# --- OSRM routing (keyless default) ----------------------------------------
# Must be a host that runs a separate osrm-routed per profile behind path
# prefixes. router.project-osrm.org does NOT: it accepts every profile slug and
# returns car results for all of them, which would silently label driving times
# as walking.
OSRM_BASE_URL=https://routing.openstreetmap.de

# The demo server accepted 120 coordinates in testing; 99 legs leaves headroom.
OSRM_MAX_LEGS_PER_REQUEST=99

# The demo servers ask for no more than ~1 request/second.
OSRM_MIN_INTERVAL_MS=1100

# --- Photon geocoding (keyless default) ------------------------------------
PHOTON_BASE_URL=https://photon.komoot.io
PHOTON_MIN_INTERVAL_MS=1100

# --- OSM courtesy identification -------------------------------------------
# OSM-hosted services require a descriptive User-Agent; a stock HTTP library
# default is explicitly not acceptable. Set a contact address before any
# non-trivial use of the shared demo servers.
OSM_APP_NAME=trip-planner
OSM_CONTACT=

# --- Map tiles --------------------------------------------------------------
# Optional MapLibre style overrides, one per theme. Leave both blank to use the
# OpenFreeMap defaults (bright for light, dark for dark), which need no key and
# no account. Available OpenFreeMap styles: liberty, bright, positron, fiord,
# dark.
#
# There is deliberately one per theme: a single shared override pins the basemap
# and stops the Appearance setting from being able to change it.
#
# Mapbox style URLs will NOT work here — their terms require Mapbox tiles be
# rendered with Mapbox SDKs.
NEXT_PUBLIC_MAP_STYLE_URL_LIGHT=
NEXT_PUBLIC_MAP_STYLE_URL_DARK=

# --- Routing cache ----------------------------------------------------------
# Days to retain routing results. Under OSRM/OSM (ODbL) there is no retention
# cap, so this is purely a freshness setting. Under ROUTING_PROVIDER=mapbox it
# is clamped to 30 days, which their Product Terms require.
CACHE_TTL_DAYS=30

# --- Mapbox (only needed when a provider above is set to `mapbox`) ---------
# SECRET token (sk.*), server-side only. Needs the Directions and/or Geocoding
# scopes. For geocoding, the account must have PERMANENT geocoding enabled,
# because we store coordinates and temporary geocoding forbids that.
MAPBOX_SECRET_TOKEN=

# --- Email (magic links) ---------------------------------------------------
# With these unset, magic links are printed to the server console in
# development so sign-in can be exercised without an email provider.
RESEND_API_KEY=
MAIL_FROM=

# --- App -------------------------------------------------------------------
# Absolute origin, used to build magic-link and share URLs. No trailing slash.
APP_URL=http://localhost:3000

# --- Optional flags --------------------------------------------------------
# Deletes anonymous trips untouched for 180 days. Destroys user-entered data,
# so it stays off until explicitly enabled.
CLEANUP_ABANDONED_TRIPS=false
